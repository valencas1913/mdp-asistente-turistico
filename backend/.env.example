# Copiá este archivo a ".env" y completá tus claves reales.
# El backend funciona igual sin claves (modo demo), pero con datos reales
# de clima e IA recién ahí queda 100% funcional.

# https://openweathermap.org/api  (plan gratuito)
OPENWEATHER_API_KEY=

# https://console.anthropic.com/  (API de Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Opcional: ruta de base de datos personalizada
# DATABASE_URL=sqlite:///mdp_guide.db

PORT=5000
